# Maverick Capshop · variáveis de ambiente (copie para .env.local e preencha; na Vercel: Settings → Environment Variables)

# Site
NEXT_PUBLIC_SITE_URL=https://maverick.viraweb.dev.br

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys / Webhooks)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Opcional: sem webhook, a loja confirma os pagamentos consultando o Stripe
STRIPE_WEBHOOK_SECRET=

# Dimona (camisadimona.com.br → conta → chave da API)
DIMONA_API_KEY=
# Opcional (padrão: https://admin.camisadimona.com.br)
DIMONA_API_BASE_URL=

# Avisos por e-mail (resend.com → API Keys)
RESEND_API_KEY=
# Opcionais
NOTIFY_EMAIL_TO=viraweb.online@gmail.com
EMAIL_FROM=Maverick Capshop <onboarding@resend.dev>

# Segurança e rotinas
IP_HASH_SALT=
CRON_SECRET=
